  <!-- GSAP CHOREOGRAPHY + HUASHU CAMERA RIG 3D -->
  <script>
    // ========================================================
    // DESIGN-ENGINEERING AUDIO ENGINE (WebAudio Suave)
    // ========================================================
    let audioCtx = null;
    function getAudio() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === "suspended") audioCtx.resume();
      return audioCtx;
    }
    window.addEventListener("pointerdown", () => getAudio(), { once: true });
    window.addEventListener("keydown", () => getAudio(), { once: true });

    function sfxCardLand() {
      const ctx = getAudio();
      if (!ctx || ctx.state !== "running") return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = "sine";
      osc.frequency.setValueAtTime(320, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(140, ctx.currentTime + 0.08);
      gain.gain.setValueAtTime(0.08, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);
      osc.connect(gain).connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.08);
    }

    function sfxFlowStart() {
      const ctx = getAudio();
      if (!ctx || ctx.state !== "running") return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = "triangle";
      osc.frequency.setValueAtTime(220, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(440, ctx.currentTime + 0.25);
      gain.gain.setValueAtTime(0.05, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.25);
      osc.connect(gain).connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.25);
    }

    function sfxArrowArrival() {
      const ctx = getAudio();
      if (!ctx || ctx.state !== "running") return;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = "sine";
      osc.frequency.setValueAtTime(587.33, ctx.currentTime);
      gain.gain.setValueAtTime(0.06, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
      osc.connect(gain).connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.35);
    }

    // 4. Acorde profundo y calmo para el Core de Postgres (Volumen 0.05)
    function sfxCoreClimax() {
      const ctx = getAudio();
      if (!ctx || ctx.state !== "running") return;
      [220, 277.18, 329.63].forEach((freq) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = "sine";
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(0.02, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.7);
        osc.connect(gain).connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.7);
      });
    }

    // 5. Whoosh cinemático de viento / brisa de aire (Ruido blanco con PRNG determinístico y filtro paso-banda)
    function sfxWhoosh() {
      const ctx = getAudio();
      if (!ctx || ctx.state !== "running") return;
      
      const bufferSize = Math.floor(ctx.sampleRate * 0.45); // 450ms de brisa
      const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      
      // PRNG Mulberry32 determinístico (cero Math.random para pasar el linter de HyperFrames)
      let s = 123456789;
      for (let i = 0; i < bufferSize; i++) {
        s |= 0; s = s + 0x6D2B79F5 | 0;
        let t = Math.imul(s ^ s >>> 15, 1 | s);
        t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
        data[i] = ((t ^ t >>> 14) >>> 0) / 4294967296 * 2 - 1;
      }

      const noise = ctx.createBufferSource();
      noise.buffer = buffer;

      // Filtro paso-banda que barre las frecuencias del viento orgánico (80Hz -> 700Hz -> 80Hz)
      const filter = ctx.createBiquadFilter();
      filter.type = "bandpass";
      filter.Q.setValueAtTime(1.6, ctx.currentTime);
      filter.frequency.setValueAtTime(90, ctx.currentTime);
      filter.frequency.exponentialRampToValueAtTime(700, ctx.currentTime + 0.2);
      filter.frequency.exponentialRampToValueAtTime(80, ctx.currentTime + 0.45);

      // Envolvente de volumen muy suave y atenuada (0.05 max)
      const gain = ctx.createGain();
      gain.gain.setValueAtTime(0.001, ctx.currentTime);
      gain.gain.linearRampToValueAtTime(0.05, ctx.currentTime + 0.2);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.45);

      noise.connect(filter).connect(gain).connect(ctx.destination);
      noise.start();
      noise.stop(ctx.currentTime + 0.45);
    }

    // ========================================================
    // HUASHU CAMERA RIG: PROXY CONTROL OBJECT (SEEK-SAFE)
    // ========================================================
    const cam = {
      cx: 960,
      cy: 540,
      zoom: 1.0,
      rotX: 0,
      rotY: 0,
      rotZ: 0
    };

    const worldEl = document.getElementById("world");

    function updateCamera() {
      // Cinemática 3D por GPU (Transform3D determinístico)
      worldEl.style.transform = 
        `translate3d(${960 - cam.cx * cam.zoom}px, ${540 - cam.cy * cam.zoom}px, 0px) ` +
        `scale3d(${cam.zoom}, ${cam.zoom}, 1) ` +
        `rotateX(${cam.rotX}deg) rotateY(${cam.rotY}deg) rotateZ(${cam.rotZ}deg)`;
    }

    window.__timelines = window.__timelines || {};
    const isStudio = window.location.hash.includes("project") || window !== window.parent;
    const tl = gsap.timeline({ paused: isStudio });

    // ESTADO INICIAL
    gsap.set("#main-header", { opacity: 0, y: -25 });
    gsap.set("#ambient-glow", { xPercent: -50, yPercent: -50, x: -550 });
    gsap.set(["#col-fase0", "#col-trans", "#col-fase1"], { opacity: 0.05, filter: "brightness(0.3) blur(4px)" });
    gsap.set([
      "#card-f0-1", "#arrow-v1", "#card-f0-2", "#arrow-v2", "#card-f0-3",
      "#card-trans-1", "#arrow-v3", "#card-trans-2", "#arrow-v4", "#card-trans-3",
      "#card-f1-1", "#arrow-v5", "#card-f1-2", "#arrow-v6", "#card-f1-3"
    ], { opacity: 0, scale: 0.85, y: 30 });
    gsap.set(["#badge-fin-fase0", "#badge-inicio-codigo"], { opacity: 0, scale: 0.3 });

    const path1 = document.getElementById("path-trans-1");
    const len1 = path1.getTotalLength() || 600;
    path1.style.strokeDasharray = len1;
    path1.style.strokeDashoffset = len1;
    gsap.set(["#path-trans-1", "#wire-trans-1", "#arrowhead-trans-1", "#dot-packet-1a", "#dot-packet-1b"], { opacity: 0 });

    const path2 = document.getElementById("path-trans-2");
    const len2 = path2.getTotalLength() || 600;
    path2.style.strokeDasharray = len2;
    path2.style.strokeDashoffset = len2;
    gsap.set(["#path-trans-2", "#wire-trans-2", "#arrowhead-trans-2", "#dot-packet-2a", "#dot-packet-2b"], { opacity: 0 });

    // APERTURA
    tl.to("#main-header", { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" }, 0.2);

    // ========================================================
    // HUASHU CAMERA RIG: COREOGRAFÍA CINEMATOGRÁFICA 3D
    // ========================================================
    // 0s: Estado inicial en PLANO FRONTAL AL 100% (Ángulo recto, sin rotación)
    cam.cx = 960;
    cam.cy = 540;
    cam.zoom = 1.0;
    cam.rotX = 0;
    cam.rotY = 0;
    cam.rotZ = 0;
    updateCamera();

    // 1.0s a 3.5s: Transición suave del plano frontal a la PERSPECTIVA 3D ISOMÉTRICA sobre Fase 0
    tl.to(cam, { 
      cx: 640, cy: 520, zoom: 1.12, rotX: 12, rotY: -14, rotZ: 2,
      duration: 2.5, ease: "power2.inOut", onUpdate: updateCamera, onStart: sfxWhoosh
    }, 1.2);

    // FASE 0: TARJETAS
    tl.to("#ambient-glow", { x: -450, background: "var(--c-f0)", opacity: 0.22, duration: 1.0 }, 1.0);
    tl.to("#col-fase0", { opacity: 1, filter: "brightness(1) blur(0px)", duration: 0.5 }, 1.2);

    tl.to("#card-f0-1", { opacity: 1, scale: 1, y: 0, duration: 0.5, ease: "back.out(1.5)", onStart: sfxCardLand }, 1.7);
    tl.to("#card-f0-1", { boxShadow: "0 0 25px rgba(56, 189, 248, 0.4)", duration: 0.25, yoyo: true, repeat: 1 }, 2.0);
